{
  "name": "@lloyal-labs/hickey",
  "version": "0.2.0",
  "description": "A commit gate that judges a change over its whole delta against your principles, with your own coding agent as the judge. The change gets in only when the whole with it makes more sense than it does today.",
  "type": "module",
  "bin": {
    "hickey": "./dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "PRINCIPLES.md",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lloyal-ai/hickey.git"
  },
  "homepage": "https://github.com/lloyal-ai/hickey#readme",
  "bugs": {
    "url": "https://github.com/lloyal-ai/hickey/issues"
  },
  "keywords": [
    "commit-gate",
    "code-review",
    "git-hooks",
    "simplicity",
    "coding-agent",
    "claude-code"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "claudeCode": "2.1.301",
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "prepare": "lefthook install",
    "prepublishOnly": "npm run check && npm run build",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "semver": "^7.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/semver": "^7.7.0",
    "lefthook": "^2.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  }
}
